# vim: ft=ghostty
# https://ghostty.org/docs/config/reference

theme = Nord Wave

font-family = Monolisa
font-size = 12
font-feature = zero, ss02, ss03, ss06, ss07, ss10, ss11, ss13, ss16

alpha-blending = native
background-opacity = 0.95
background-blur-radius = 20

background = #191c1f
window-padding-x = 8
window-padding-y = 2
window-save-state = always

copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

macos-non-native-fullscreen = visible-menu
macos-option-as-alt = left
# macos-titlebar-style = tabs
macos-titlebar-style = native

desktop-notifications = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

scrollback-limit = 1000000000
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

mouse-hide-while-typing = true

# --- Split focus: dim inactive panes harder (default 0.7) and brighten dividers
unfocused-split-opacity = 0.5

keybind = ctrl+backquote=toggle_quick_terminal

keybind = cmd+d=new_split:right
keybind = chain=equalize_splits

keybind = cmd+shift+d=new_split:down
keybind = chain=equalize_splits
