# vim: set filetype=gitattributes shiftwidth=4 tabstop=4 expandtab :
# git configuration

[user]
    signingkey = {{ onepasswordRead "op://Personal/e2mtrwnrr2yeo4axh2f3ukd3hm/public key" .onepasswordAccount }}

[alias]
    s = status -sb
    l = log --graph --decorate --oneline -20
    la = log --graph --decorate --oneline --all -40
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    co = checkout
    g = grep --break --heading --line-number
    gi = grep --break --heading --line-number -i

[core]
    pager = delta

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[merge]
    conflictstyle = zdiff3

[fetch]
    prune = true
    pruneTags = true

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true
    ff = only

[diff]
    algorithm = histogram
    colorMoved = default
    colorMovedWs = allow-indentation-change
    renames = copies
    mnemonicPrefix = true

[log]
    date = iso

[help]
    autocorrect = prompt

[transfer]
    fsckobjects = true

[diff "sopsdiffer"]
    textconv = "sops decrypt"

[delta]
    features = decorations
    syntax-theme = Nord
    plus-style = bold "#002800" "#809575"
    minus-style = bold "#3f0001" "#94545d"

[delta "decorations"]
    hunk-header-style = file line-number syntax
    file-style = omit
    hunk-header-file-style = blue
    hunk-header-line-number-style = bold black
    hunk-header-decoration-style = omit

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
    {{- if eq .chezmoi.os "darwin" }}
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    {{- end }}

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[pager]
    branch = false

{{ if .personal -}}
[includeIf "hasconfig:remote.*.url:git@github.com:**/**"]
    path = ~/.config/git/config.github
[includeIf "hasconfig:remote.*.url:git@gitlab.com:**/**"]
    path = ~/.config/git/config.gitlab

[url "git@gitlab.com:nick.mcfaul/"]
    insteadOf = https://gitlab.com/nick.mcfaul/
[url "git@github.com:mcf.io/"]
    insteadOf = https://gitlab.com/mcf.io/
[url "git@gitlab.com:"]
    pushInsteadOf = https://gitlab.com/

[url "git@github.com:mcfio/"]
    insteadOf = https://github.com/mcfio/
[url "git@github.com:rkage/"]
    insteadOf = https://github.com/rkage/
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
{{- end }}

{{ $ghPath := lookPath "gh" -}}
{{ if $ghPath -}}
[credential "https://github.com"]
    helper = !{{ $ghPath }} auth git-credential
[credential "https://gist.github.com"]
    helper = !{{ $ghPath }} auth git-credential
{{- end }}
