#!/usr/bin/env bash
# vim: set filetype=bash shiftwidth=2 tabstop=2 expandtab :

# intentionally NOT using `-e`, so one failing `defaults write` (e.g. a
# key a newer macOS removed) doesn't abort the rest of the script.
set -uo pipefail

# Close any open System Settings panes, to prevent them from overriding
# settings we're about to change
osascript -e 'tell application "System Settings" to quit'

# Ask for administrator password
sudo -v

# Keep the sudo timestamp alive for the duration of this script, so later
# `sudo` calls (e.g. scutil) don't stall on a re-prompt
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_KEEPALIVE_PID=$!
trap 'kill "${SUDO_KEEPALIVE_PID}" 2>/dev/null' EXIT

## UI/UX/QoL items

# Set compuer name (as if I set it up via System Preferences -> Sharing)
sudo scutil --set HostName "{{ .hostname }}"
sudo scutil --set LocalHostName "{{ .hostname }}"
sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server NetBIOSName -string "{{ .hostname }}"

# Avoid screenshot clutter
defaults write com.apple.screencapture location -string "{{ .chezmoi.homeDir }}/Desktop/Screenshots"
defaults write com.apple.screencapture type -string "png"
defaults write com.apple.screencapture disable-shadow -bool true

# Disable some "smart" formatting options, such as automatic captialization (System Preferences -> Keyboard -> Text)
defaults write -globalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write -globalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# Configure bottom-left hot-corner for sleep
defaults write com.apple.dock wvous-bl-corner -int 10
defaults write com.apple.dock wvous-bl-modifier -int 0

# Don't show the "application quit unexpectedly" crash reporter dialog
defaults write com.apple.CrashReporter DialogType -string "none"

# Unhide ~/Library in Finder
chflags nohidden "{{ .chezmoi.homeDir }}/Library"

## Finder Stuff

# Show filename extensions and disable warning when changing them
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder FXEnableExtensionChangingWarning -bool false

# Show path bar and status bar
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true

# Show full POSIX path as Finder window title
defaults write com.apple.finder _FXShowPosixPathInTitle -bool true

# When sorting by name, keep folders on top
defaults write com.apple.finder _FXSortFoldersFirst -bool true

# Search the current folder by default
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# Don't creat .DS_Store files on network or USB volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Default to list view (other modes: Icons -> `icnv`, Columns -> `clmv`, Gallery -> `glyv`)
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

for app in "Finder" \
  "Dock" \
  "SystemUIServer"; do
  killall "${app}" &> /dev/null
done
